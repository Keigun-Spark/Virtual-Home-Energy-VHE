FROM --platform=linux/arm64/v8 ghcr.io/homematicip/alpine-jre:0.0.1
RUN apk add --update --no-cache openjdk11-jre

LABEL de.eq3.hmip.plugin.metadata="{\"pluginId\":\"de.spark.keigun.plugin.virtualhomeenergy\", \
    \"version\":\"1.0.0\", \
    \"issuer\":\"Keigun-Spark\", \
    \"scope\":\"LOCAL\", \
    \"logsEnabled\": true, \
    \"hcuMinVersion\":\"1.4.7\", \
    \"friendlyName\":{\"en\":\"Virtual Home Energy\",\"de\":\"Virtuelle Hausenergie\"}, \
    \"description\":{\"en\":\"Calculates unaccounted household energy consumption by aggregating data from connected energy meters and power-producing devices\",\"de\":\"Berechnet den nicht gemessenen Stromverbrauch des Haushalts durch Aggregation von Daten aus verbundenen Energiemessern und Stromerzeugungsgeräten\"}, \
    \"image\":\"\" \
    }"

WORKDIR /app
RUN mkdir -p /data && chown -R daemon /data
RUN mkdir -p /app && chown -R daemon /app
COPY --chown=daemon:daemon maven/ /app/

ENV HCU_HOST=host.containers.internal
ENV AUTH_TOKEN_FILE=/TOKEN

ENTRYPOINT java -Xms8m -Xmx32m -XX:-TieredCompilation -Dfile.encoding=UTF-8 -jar /app/${project.artifactId}-${project.version}.jar
